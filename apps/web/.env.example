# Copy to .env.local (gitignored) and fill in. Read by the web server on startup.
# Fine-grained token with read-only "Issues" access is enough.
GITLIB_GITHUB_TOKEN=
# How often (in hours) GitHub community scores are fetched again; 0 = only when you press Refresh.
#GITLIB_COMMUNITY_REFRESH_HOURS=24
# The "Ask" panel's Ollama server (default http://127.0.0.1:11434), the model to use unless you pick another in the
# panel (blank = the first installed), and the context window in tokens sent with every request.
#GITLIB_OLLAMA_HOST=http://192.168.1.50:11434
#GITLIB_OLLAMA_MODEL=qwen3:8b
#GITLIB_OLLAMA_NUM_CTX=8192
# Contribution graph "Local + GitHub & GitLab": GitHub uses the token above (any read-only token works).
# GitLab reads your public contribution calendar; set GITLIB_GITLAB_URL too if you self-host.
# How often (in hours) the GitHub and GitLab repository lists are checked again; 0 = only the Refresh button.
#GITLIB_REPO_REFRESH_HOURS=6
# The GitLab and Combined tabs list your projects. A personal access token with the read_api scope also reaches
# private projects; with only a username, public projects are listed. The GitHub tabs use the token above, which
# needs to be able to read your repositories.
GITLIB_GITLAB_TOKEN=
GITLIB_GITLAB_USERNAME=
GITLIB_GITLAB_URL=
