# Copy to .env.local (gitignored) and fill in. Read by the web server on startup.
# Fine-grained token with read-only "Issues" access is enough.
GITLIB_GITHUB_TOKEN=
# Contribution graph "Local + GitHub & GitLab": GitHub uses the token above (any read-only token works).
# GitLab reads your public contribution calendar; set GITLIB_GITLAB_URL too if you self-host.
GITLIB_GITLAB_USERNAME=
GITLIB_GITLAB_URL=
