# Settings for `docker compose` (copy to .env, which is gitignored). Every line is optional.
# Running the web app outside Docker (`npm run web`) uses apps/web/.env.example instead.
#
# Installing on a server / homelab VM and opening the app from another machine? Change GITLIB_BIND below to
# 0.0.0.0 (the default 127.0.0.1 only answers on the server itself, so other machines get "connection refused"),
# then run `docker compose up -d`. Allow the port in the VM's firewall if it has one. See docs/runbook.md.

# --- Where things listen -----------------------------------------------------------------------------
# Host port for the web app. 4000 by default so it stays clear of other local dev servers.
GITLIB_PORT=4000
# Interface the port is published on. 127.0.0.1 = this machine only (right for a Mac).
# Use 0.0.0.0 on the homelab VM to reach it from the LAN (REQUIRED for http://<server-ip>:4000 to work).
# The app has no login: keep it off the internet.
GITLIB_BIND=127.0.0.1

# --- Files on the host -------------------------------------------------------------------------------
# Directory on the host holding the git repositories to browse. It is mounted read-only at /home/node/git
# inside the container. Defaults to ~/git. Use an absolute path (or ~/...) for anywhere else, e.g.
#   GITLIB_REPOS=/Volumes/work/code
# After changing it run `docker compose up -d` (recreates the container), then press Rescan in the app.
# On Docker Desktop the folder must be shared: Settings > Resources > File sharing (your home is by default).
#GITLIB_REPOS=~/git
# Where backup archives are written by scripts/backup.sh.
GITLIB_BACKUPS=./backups

TZ=UTC

# --- Search (Meilisearch) ----------------------------------------------------------------------------
# Development mode needs no key. On the homelab set MEILI_ENV=production and a key of 16+ characters:
#   openssl rand -hex 24
MEILI_ENV=development
GITLIB_MEILI_API_KEY=
# Host port for reaching Meilisearch directly (loopback only). Not needed for normal use.
GITLIB_MEILI_PORT=7711

# --- Chat (Ollama) -----------------------------------------------------------------------------------
# The "Ask" panel answers questions about your repositories with a model on an Ollama server. Blank means
# http://127.0.0.1:11434, which inside Docker is the container itself, so for a server elsewhere on your network set
# its address, e.g. GITLIB_OLLAMA_HOST=http://192.168.1.50:11434. On that machine Ollama must listen beyond loopback
# (OLLAMA_HOST=0.0.0.0:11434). Ollama has no login: keep it off the internet.
GITLIB_OLLAMA_HOST=
# Model used unless you pick another in the panel, e.g. qwen3:8b. Blank = the first model the server lists.
GITLIB_OLLAMA_MODEL=
# Context window, in tokens, sent with every request. A larger one remembers more but needs more GPU memory (8192 is
# comfortable on a 12 GB card). Ollama reloads a model when this changes between requests, so keep one value.
#GITLIB_OLLAMA_NUM_CTX=8192

# --- Integrations ------------------------------------------------------------------------------------
# Fine-grained token with read-only "Issues" access is enough. Not included in backups: keep it elsewhere.
GITLIB_GITHUB_TOKEN=
# How often (in hours) GitHub community scores are fetched again. They are stored in the database, so this is
# the only time they cost GitHub requests besides the Refresh buttons. 0 turns automatic refreshing off.
#GITLIB_COMMUNITY_REFRESH_HOURS=24
# How often (in hours) the GitHub and GitLab repository lists are checked again. They are stored in the database
# and checked with ETags, so a check that finds nothing new costs no GitHub quota. 0 = only the Refresh button.
#GITLIB_REPO_REFRESH_HOURS=6
# Lists your GitLab projects on the Repositories page (GitLab and Combined tabs). A personal access token with
# the read_api scope also reaches private projects; with only a username, public projects are listed.
GITLIB_GITLAB_TOKEN=
GITLIB_GITLAB_USERNAME=
GITLIB_GITLAB_URL=
